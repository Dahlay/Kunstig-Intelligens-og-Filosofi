<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>@MACOSX_BUNDLE_EXECUTABLE_NAME@</string>

  <key>CFBundleIdentifier</key>
  <string>com.even.modularaudiopatcher</string>

  <key>CFBundleName</key>
  <string>Modular Audio Patcher</string>

  <key>CFBundleDisplayName</key>
  <string>Modular Audio Patcher</string>

  <key>CFBundleShortVersionString</key>
  <string>@MAP_VERSION@</string>

  <key>CFBundleVersion</key>
  <string>@MAP_VERSION@</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleSignature</key>
  <string>????</string>

  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>

  <!-- Audio I/O entitlement description shown by macOS -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Modular Audio Patcher uses the microphone for audio input routing.</string>

  <key>NSHighResolutionCapable</key>
  <true/>

  <key>LSApplicationCategoryType</key>
  <string>public.app-category.music</string>

  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2025 Even. All rights reserved.</string>
</dict>
</plist>
